# Copy this file to `.env.local` and adjust if your setup differs.
# NEVER put stream keys, OAuth tokens or any other secret in a Vite env file -
# everything prefixed with VITE_ is inlined into the public JavaScript bundle.

# Base URL used by the frontend when calling the backend REST API.
# Leave empty to use same-origin relative requests (recommended in development,
# where the Vite dev server proxies /api to the Go backend).
VITE_API_BASE_URL=

# Target of the Vite dev-server proxy for /api. Change only if the Go backend
# listens on a different host/port than the default.
VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:8080
