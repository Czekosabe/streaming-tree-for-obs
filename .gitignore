# --- Dependencies ---
node_modules/
.pnp/
.pnp.js

# --- Build output ---
dist/
/build/
*.tsbuildinfo

# --- Go ---
# Compiled server binaries (see apps/server)
apps/server/bin/
apps/server/streaming-tree-server
apps/server/streaming-tree-server.exe
*.exe
*.test

# --- Secrets / local configuration ---
# Stream keys, OAuth tokens and any credentials must NEVER be committed.
# Anchored to the repository root on purpose: an unanchored "secrets/" also
# matched the source package apps/server/internal/secrets/, exactly as an
# unanchored "data/" once hid apps/web/src/data/ and unanchored "mediamtx"
# once hid apps/server/internal/runtime/mediamtx/. Real credentials are never
# file-based in this project (see internal/secrets) - these two rules are a
# defensive backstop for a manually created local directory, not the actual
# storage mechanism.
.env
.env.*
!.env.example
*.local
/secrets/
/credentials/

# --- Runtime data (added in later stages) ---
# Anchored to the repository root on purpose: unanchored "data/" and "logs/"
# also matched source directories such as apps/web/src/data/.
/data/
/logs/
*.db
*.sqlite
*.sqlite3
*.log

# --- Third party binaries downloaded locally ---
# Anchored to the repository root on purpose. Unanchored "mediamtx" also
# matched the source package apps/server/internal/runtime/mediamtx/, exactly as
# an unanchored "data/" once hid apps/web/src/data/.
#
# Managed third-party binaries are installed into the per-user application data
# directory, never into the working copy, so these rules only guard against a
# manual download left at the repository root.
vendor/bin/
/mediamtx
/mediamtx.exe
/ffmpeg
/ffmpeg.exe

# --- Local tooling settings ---
.claude/settings.local.json

# --- Editors / OS ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# --- Tooling caches ---
.eslintcache
.vite/
coverage/

# --- Playwright E2E harness output (apps/web/e2e) ---
# Anchored under apps/web/ so an unrelated top-level "test-results" or
# "playwright-report" directory elsewhere is never accidentally hidden.
apps/web/test-results/
apps/web/e2e/report/
apps/web/blob-report/

# --- Stage 20A embedded release assets ---
# The release build script stages the real production frontend build and
# the canonical legal documents into these directories immediately before
# building the release binary (see docs/windows-packaging.md §2/§16). Only
# the tracked .gitkeep placeholder in each ships in source control - the
# generated content must never be committed.
apps/server/internal/webassets/embedded/*
!apps/server/internal/webassets/embedded/.gitkeep
apps/server/internal/webassets/legal/*
!apps/server/internal/webassets/legal/.gitkeep

# --- Stage 20A local release build output ---
build/release/
